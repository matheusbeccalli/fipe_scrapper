# FIPE Scraper Environment Variables
# Copy this file to .env and update with your actual values
# NEVER commit .env to git!

# Database Configuration
# Default: SQLite (no credentials needed)
DATABASE_URL=sqlite:///fipe_data.db

# For PostgreSQL (uncomment and update):
# DATABASE_URL=postgresql://username:password@localhost:5432/fipe_db

# For MySQL (uncomment and update):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/fipe_db

# Logging Configuration (optional)
LOG_FILE=fipe_scraper.log
LOG_LEVEL=INFO
LOG_ROTATION=50 MB

# Date Range Configuration (optional)
# Format: YYYY-MM (e.g., 2024-01 for January 2024)
# Set to scrape only specific months, or comment out to scrape all available months
SCRAPE_START_DATE=2024-01
SCRAPE_END_DATE=2024-01

# Brand Filter Configuration (optional)
# Enable brand filtering to scrape only specific brands
# BRAND_FILTER_ENABLED: Set to 'true' to enable filtering, 'false' to scrape all brands
# BRAND_FILTER_CODES: Comma-separated list of brand codes (e.g., '6,59' for Audi and Volkswagen)
#
# How to find brand codes:
# 1. See complete list in docs/BRAND_CODES.md (103 brands as of October 2025)
# 2. Check your database: SELECT brand_code, brand_name FROM brands;
# 3. Or visit the FIPE API and inspect the brand dropdown values
#
# Smart skipping: If a brand already has complete data for the specified date range,
# it will be automatically skipped (useful when re-running with broader brand selection)
#
# Examples:
# BRAND_FILTER_ENABLED=true
# BRAND_FILTER_CODES=6,59
#
BRAND_FILTER_ENABLED=false
BRAND_FILTER_CODES=

# Proxy Rotation Configuration (optional)
# Enable proxy rotation to avoid rate limiting (429 errors)
# PROXY_ENABLED: Set to 'true' to enable proxy rotation, 'false' to use direct connection
# PROXY_FILE: Path to file containing proxy list (one per line)
# PROXY_MAX_FAILURES: Number of consecutive failures before blacklisting a proxy
#
# Proxy file format (proxies.txt):
#   - http://ip:port      (HTTP proxy)
#   - socks4://ip:port    (SOCKS4 proxy)
#   - socks5://ip:port    (SOCKS5 proxy)
#   - ip:port             (defaults to http://)
#
# Features:
#   - Round-robin rotation on every request
#   - Automatic blacklisting of failed proxies
#   - User-Agent rotation (50+ realistic browser strings)
#   - Falls back to direct connection when all proxies exhausted
#
PROXY_ENABLED=true
PROXY_FILE=proxies.txt
PROXY_MAX_FAILURES=5

# Maximum concurrent connections (workers)
# Each worker uses one proxy. If you have more proxies than this limit,
# only the first N proxies will be used.
# Set to 0 for unlimited (use all proxies)
MAX_CONCURRENT_CONNECTIONS=250
