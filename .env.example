# FIPE Scraper Environment Variables
# Copy this file to .env and update with your actual values
# NEVER commit .env to git!

# Database Configuration
# Default: SQLite (no credentials needed)
DATABASE_URL=sqlite:///fipe_data.db

# For PostgreSQL (uncomment and update):
# DATABASE_URL=postgresql://username:password@localhost:5432/fipe_db

# For MySQL (uncomment and update):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/fipe_db

# Logging Configuration (optional)
LOG_FILE=fipe_scraper.log
LOG_LEVEL=INFO
LOG_ROTATION=50 MB

# Date Range Configuration (optional)
# Format: YYYY-MM (e.g., 2024-01 for January 2024)
# Set to scrape only specific months, or comment out to scrape all available months
SCRAPE_START_DATE=2024-01
SCRAPE_END_DATE=2024-01
